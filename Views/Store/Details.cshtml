@model EddaStore.Models.Products.Product
@{ ViewData["Title"] = Model.Name; var image = Model.Images.OrderByDescending(i=>i.IsPrimary).ThenBy(i=>i.SortOrder).FirstOrDefault(); }
<section class="page-head"><div class="container"><div class="breadcrumbs"><a asp-controller="Home" asp-action="Index">الرئيسية</a> / <a asp-action="Index">المنتجات</a> / @Model.Name</div><h1>تفاصيل المنتج</h1></div></section>
<div class="container section"><section class="detail-grid"><div class="detail-image">@if(!string.IsNullOrWhiteSpace(image?.ImageUrl)){<img src="@image.ImageUrl" alt="@(image?.AltText ?? Model.Name)"/>}else{<div class="empty">لا توجد صورة للمنتج</div>}</div><div class="detail-info"><span class="eyebrow">@Model.Category.Name — @Model.Brand.Name</span><h1>@Model.Name</h1><div class="rating">★ منتج مختار بعناية</div><div class="price-row"><span class="price">@Model.Price.ToString("N0") ج.م</span>@if(Model.CompareAtPrice > Model.Price){<span class="old-price">@Model.CompareAtPrice?.ToString("N0") ج.م</span>}</div><span class="stock">@(Model.StockQuantity > 0 ? "● متوفر في المخزون" : "غير متوفر حاليًا")</span><p>@Model.Description</p>@if(User.Identity?.IsAuthenticated == true){<form asp-controller="Wishlist" asp-action="Add" method="post"><input type="hidden" name="productId" value="@Model.Id"/><input type="hidden" name="returnUrl" value="@Context.Request.Path"/><button class="btn btn-outline" type="submit">♡ أضف للمفضلة</button></form>}@if(Model.StockQuantity > 0){<form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="productId" value="@Model.Id"/><input type="hidden" name="returnUrl" value="@Context.Request.Path"/><div class="detail-actions"><div class="quantity"><input aria-label="الكمية" type="number" name="quantity" value="1" min="1" max="@Model.StockQuantity"/></div><button class="btn btn-primary" type="submit">أضف للسلة</button></div></form>}<div class="feature-list"><span>✓ تفاصيل واضحة وأسعار مباشرة</span><span>✓ تجربة شراء بسيطة وآمنة</span><span>✓ تصفح منتجات تقنية مختارة</span></div></div></section></div>
<div class="container section">
    <section class="panel">
        <h2>المراجعات المعتمدة</h2>
        @{
            var reviews = ViewBag.Reviews as List<EddaStore.Models.Customers.Review> ?? new();
        }
        @if (!reviews.Any())
        {
            <p class="muted">لا توجد مراجعات معتمدة حتى الآن.</p>
        }
        else
        {
            <div class="review-list">
                @foreach (var review in reviews)
                {
                    <article class="review-item">
                        <strong>★ @review.Rating / 5</strong>
                        <p>@review.Comment</p>
                    </article>
                }
            </div>
        }

        @if (User.Identity?.IsAuthenticated == true)
        {
            <form asp-controller="Store" asp-action="SubmitReview" method="post" class="form-grid" style="margin-top:16px;">
                <input type="hidden" name="slug" value="@Model.Slug" />
                <label>التقييم
                    <select name="rating">
                        @for (var i = 5; i >= 1; i--)
                        {
                            <option value="@i">@i</option>
                        }
                    </select>
                </label>
                <label>تعليق
                    <textarea name="comment" rows="3"></textarea>
                </label>
                <button class="btn btn-primary" type="submit">إرسال مراجعة</button>
            </form>
        }
    </section>
</div>
