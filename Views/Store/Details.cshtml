@model EddaStore.Models.Products.Product

@{
    ViewData["Title"] = Model.Name;
    ViewData["MetaDescription"] = string.IsNullOrWhiteSpace(Model.Description)
        ? $"تفاصيل وسعر {Model.Name} من {Model.Brand.Name} في متجر عِدّة."
        : (Model.Description.Length > 155
            ? Model.Description[..155]
            : Model.Description);

    var image = Model.Images
        .OrderByDescending(i => i.IsPrimary)
        .ThenBy(i => i.SortOrder)
        .FirstOrDefault();

    // المراجعات التي تم اعتمادها فقط.
    var reviews = ViewBag.Reviews as List<EddaStore.Models.Customers.Review>
        ?? new List<EddaStore.Models.Customers.Review>();

    var productSchema = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Product",
        ["name"] = Model.Name,
        ["description"] = Model.Description ?? string.Empty,
        ["sku"] = Model.SKU ?? string.Empty,
        ["brand"] = new Dictionary<string, object?>
        {
            ["@type"] = "Brand",
            ["name"] = Model.Brand.Name
        },
        ["offers"] = new Dictionary<string, object?>
        {
            ["@type"] = "Offer",
            ["priceCurrency"] = "EGP",
            ["price"] = Model.Price,
            ["availability"] = Model.StockQuantity > 0
                ? "https://schema.org/InStock"
                : "https://schema.org/OutOfStock",
            ["url"] = ViewData["CanonicalUrl"] as string
                ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}{Context.Request.Path}"
        }
    };

    // أضف التقييم الإجمالي من المراجعات المعتمدة والصحيحة فقط.
    var approvedRatings = reviews
        .Where(r => r.Rating >= 1 && r.Rating <= 5)
        .ToList();

    if (approvedRatings.Count > 0)
    {
        productSchema["aggregateRating"] = new Dictionary<string, object?>
        {
            ["@type"] = "AggregateRating",
            ["ratingValue"] = Math.Round(
                approvedRatings.Average(r => r.Rating), 2),
            ["reviewCount"] = approvedRatings.Count,
            ["bestRating"] = 5,
            ["worstRating"] = 1
        };
    }

    if (!string.IsNullOrWhiteSpace(image?.ImageUrl))
    {
        productSchema["image"] = image.ImageUrl.StartsWith("/")
            ? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}{image.ImageUrl}"
            : image.ImageUrl;
    }
}

@section StructuredData {
    <script type="application/ld+json">@Html.Raw(
                                                                                                                                                                                            System.Text.Json.JsonSerializer.Serialize(productSchema)
                                    )</script>
    }

    <section class="page-head">
        <div class="container">
            <div class="breadcrumbs"><a asp-controller="Home" asp-action="Index">الرئيسية</a> / <a
                asp-action="Index">المنتجات</a> / @Model.Name</div>
            </div>
        </section>
        <div class="container section">
            <section class="detail-grid">
                <div class="detail-image product-gallery" id="productGallery" tabindex="0" role="region"
                     aria-label="معرض صور المنتج">
                    @{
                        var orderedImages = Model.Images
                            .Where(i => !string.IsNullOrWhiteSpace(i.ImageUrl))
                            .OrderByDescending(i => i.IsPrimary)
                            .ThenBy(i => i.SortOrder)
                            .ToList();
                        var mainImage = orderedImages.FirstOrDefault();
                    }
                    @if (mainImage is not null)
                    {
                        <img id="productMainImage" src="@mainImage.ImageUrl" alt="@(mainImage.AltText ?? Model.Name)" />
                        @if (orderedImages.Count > 1)
                        {
                            <div class="product-gallery-controls">
                                <button type="button" class="product-gallery-nav product-gallery-prev" id="productGalleryPrev"
                                        aria-label="Previous">السابق</button>
                                <button type="button" class="product-gallery-nav product-gallery-next" id="productGalleryNext"
                                        aria-label="Next">التالي</button>
                            </div>
                            <div class="product-thumbnails">
                                @for (var i = 0; i < orderedImages.Count; i++)
                                {
                                    var img = orderedImages[i];
                                    <button type="button" class="product-thumbnail @(img == mainImage ? "is-active" : "")" data-index="@i"
                                            data-src="@img.ImageUrl" data-alt="@(img.AltText ?? Model.Name)"
                                            aria-label="عرض صورة @(img.AltText ?? Model.Name)">
                                        <img src="@img.ImageUrl" alt="@(img.AltText ?? Model.Name)" loading="lazy" />
                                    </button>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty">لا توجد صورة للمنتج</div>
                    }
                </div>
                <div class="detail-info"><span class="eyebrow">@Model.Category.Name — @Model.Brand.Name</span>
                    <h1>@Model.Name</h1>
                    <div class="price-row"><span class="price">@Model.Price.ToString("N0") ج.م</span>@if(Model.CompareAtPrice >
                        Model.Price){
                            <span class="old-price">@Model.CompareAtPrice?.ToString("N0") ج.م</span>
                        }
                    </div><span class="stock">@(Model.StockQuantity > 0 ? "● متوفر في المخزون" : "غير متوفر حاليًا")</span>
                    <p>@Model.Description</p>@if(User.Identity?.IsAuthenticated == true){
                    <form asp-controller="Wishlist" asp-action="Add" method="post"><input type="hidden" name="productId"
                                                                                              value="@Model.Id" /><input type="hidden" name="returnUrl" value="@Context.Request.Path" /><button
                        class="btn btn-outline" type="submit">♡ أضف للمفضلة</button></form>
                    }
                    @if (Model.StockQuantity > 0)
                    {
                        <form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="productId"
                                                                                              value="@Model.Id" /><input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                            <div class="detail-actions">
                                <div class="quantity"><input aria-label="الكمية" type="number" name="quantity" value="1" min="1"
                                                                 max="@Model.StockQuantity" /></div><button class="btn btn-primary" type="submit">أضف
                                    للسلة</button>
                                </div>
                            </form>
                        }
                        <div class="feature-list"><span>راجع المواصفات والوصف قبل الشراء</span><span>حالة التوفر موضحة في
                            صفحة المنتج</span><span>للاستفسار، تواصل مع خدمة العملاء</span></div>
                        </div>
                    </section>
                </div>
                <div class="container section">
                    <section class="panel">
                        <h2>المراجعات المعتمدة</h2>
                        @if (!reviews.Any())
                        {
                            <p class="muted">لا توجد مراجعات معتمدة حتى الآن.</p>
                        }
                        else
                        {
                            <div class="review-list">
                                @foreach (var review in reviews)
                                {
                                    <article class="review-item">
                                        <strong>★ @review.Rating / 5</strong>
                                        <p>@review.Comment</p>
                                    </article>
                                }
                            </div>
                        }

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form asp-controller="Store" asp-action="SubmitReview" method="post" class="form-grid review-form">
                                <input type="hidden" name="slug" value="@Model.Slug" />
                                <label>التقييم
                                    <select name="rating">
                                        @for (var i = 5; i >= 1; i--)
                                        {
                                            <option value="@i">@i</option>
                                        }
                                    </select>
                                </label>
                                <label>تعليق
                                    <textarea name="comment" rows="3" maxlength="1000" required></textarea>
                                </label>
                                <button class="btn btn-primary" type="submit">إرسال مراجعة</button>
                            </form>
                        }
                    </section>
                </div>
                @section Scripts {
                    <script>
                        (function () {
                            const gallery = document.getElementById('productGallery');
                            const mainImage = document.getElementById('productMainImage');
                            const thumbnails = Array.from(document.querySelectorAll('.product-thumbnail'));
                            const prevButton = document.getElementById('productGalleryPrev');
                            const nextButton = document.getElementById('productGalleryNext');

                            if (!mainImage || thumbnails.length === 0) {
                                return;
                            }

                            const images = thumbnails.map(function (button) {
                                return {
                                    src: button.dataset.src,
                                    alt: button.dataset.alt || mainImage.alt,
                                    button: button
                                };
                            });

                            let currentIndex = thumbnails.findIndex(function (button) {
                                return button.classList.contains('is-active');
                            });
                            if (currentIndex < 0) {
                                currentIndex = 0;
                            }

                            function showImage(index) {
                                if (images.length === 0) {
                                    return;
                                }
                                currentIndex = (index % images.length + images.length) % images.length;
                                const item = images[currentIndex];
                                mainImage.src = item.src;
                                mainImage.alt = item.alt || mainImage.alt;
                                thumbnails.forEach(function (button, buttonIndex) {
                                    button.classList.toggle('is-active', buttonIndex === currentIndex);
                                });
                                const activeThumbnail = thumbnails[currentIndex];
                                if (activeThumbnail && typeof activeThumbnail.scrollIntoView === 'function') {
                                    activeThumbnail.scrollIntoView({ block: 'nearest', inline: 'nearest' });
                                }
                            }

                            thumbnails.forEach(function (button, index) {
                                button.addEventListener('click', function () {
                                    showImage(index);
                                });
                            });

                            if (prevButton) {
                                prevButton.addEventListener('click', function () {
                                    showImage(currentIndex - 1);
                                });
                            }

                            if (nextButton) {
                                nextButton.addEventListener('click', function () {
                                    showImage(currentIndex + 1);
                                });
                            }

                            if (gallery) {
                                gallery.addEventListener('keydown', function (event) {
                                    if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
                                        event.preventDefault();
                                        showImage(currentIndex - 1);
                                    } else if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
                                        event.preventDefault();
                                        showImage(currentIndex + 1);
                                    } else if (event.key === 'Home') {
                                        event.preventDefault();
                                        showImage(0);
                                    } else if (event.key === 'End') {
                                        event.preventDefault();
                                        showImage(images.length - 1);
                                    }
                                });
                            }
                        })();
                    </script>
                }

