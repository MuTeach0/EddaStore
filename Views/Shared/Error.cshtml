@model ErrorViewModel
@{
    ViewData["Title"] = "حدث خطأ"; ViewData["MetaDescription"] = "تعذر إكمال الطلب حاليًا."; ViewData["Robots"] =
    "noindex, nofollow";
}
<section class="page-head">
    <div class="container">
        <h1>حصلت مشكلة غير متوقعة</h1>
        <p>مش قادرين نكمل طلبك دلوقتي. جرّب مرة تانية أو ارجع للصفحة الرئيسية.</p>
    </div>
</section>
<div class="container section">
    <section class="panel error-panel">
        <p>لو المشكلة مستمرة، تواصل مع خدمة العملاء واذكر وقت حدوثها.</p>@if (Model.ShowRequestId) {
        <p class="request-reference">رقم مرجعي للمشكلة: <code>@Model.RequestId</code></p>
    }
    <div class="hero-actions"><a class="btn btn-primary" asp-controller="Home" asp-action="Index">العودة
        للرئيسية</a><a class="btn btn-outline" asp-controller="Home" asp-action="Contact">تواصل معنا</a></div>
    </section>
</div>