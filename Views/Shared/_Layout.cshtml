<!doctype html>
<html lang="ar" dir="rtl">
@{
    var pageTitle = ViewData["Title"] as string;
    var fullTitle = string.IsNullOrWhiteSpace(pageTitle) ? "عِدّة | متجر الكمبيوتر واللابتوب والإكسسوارات" : $"{pageTitle} | عِدّة";
    var metaDescription = ViewData["MetaDescription"] as string ?? "عِدّة متجر تقني لمنتجات الكمبيوتر واللابتوب والإكسسوارات. تصفح تفاصيل المنتجات وأسعارها وتواصل معنا للاستفسار قبل الشراء.";
    var isPrivatePage = ViewData["Robots"] as string ?? (Context.Request.Path.StartsWithSegments("/Account") ||
Context.Request.Path.StartsWithSegments("/Cart") || Context.Request.Path.StartsWithSegments("/Checkout") ? "noindex, nofollow" : "index, follow");
    var canonicalUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}{Context.Request.Path}";
    var whatsappUrl = "https://wa.me/201002270587";
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#26372D" />
    <meta name="description" content="@metaDescription" />
    <meta name="robots" content="@isPrivatePage" />
    <link rel="canonical" href="@canonicalUrl" />
    <meta property="og:locale" content="ar_EG" />
    <meta property="og:site_name" content="عِدّة EddaStore" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@fullTitle" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:url" content="@canonicalUrl" />
    <script
    type="application/ld+json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new Dictionary<string, object?> { ["\u0040context"] = "https://schema.org", ["\u0040type"] = "Organization", ["name"] = "عِدّة EddaStore", ["description"] = metaDescription, ["telephone"] = "+201002270587", ["url"] = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}", ["logo"] = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}/assets/brand-mark.svg" }))</script>
    <title>@fullTitle</title>
    <link rel="icon" href="~/assets/brand-mark.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;600;700;800;900&display=swap"
          rel="stylesheet" />
    <link rel="stylesheet" href="~/assets/styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />
</head>

<body>
    <div class="announcement">عِدّة EDDA <span aria-hidden="true">•</span> وجهتك لمنتجات الكمبيوتر واللابتوب
        والإكسسوارات</div>
        <header class="header">
            <div class="container header-main">
                <a class="brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="الصفحة الرئيسية">
                    <img src="~/assets/brand-mark.svg" alt="شعار عِدّة" />
                    <span><span class="brand-name">عِدّة</span><span class="brand-tag">تقنيتك تبدأ من هنا</span></span>
                </a>
                <form class="search" asp-area="" asp-controller="Store" asp-action="Index" method="get" role="search">
                    <input type="search" name="q" value="@Context.Request.Query["q"]"
                           placeholder="بتدور على إيه؟ لابتوب، شاشة، إكسسوارات..." aria-label="ابحث عن منتج" />
                </form>
                <div class="header-actions">
                    @if (User.IsInRole("Admin"))
                    {
                        <a class="header-admin-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">▦ <span>لوحة
                            التحكم</span></a>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="icon-link" asp-area="" asp-controller="Account" asp-action="Index" aria-label="حسابي"
                               title="حسابي">♙</a>
                            <form class="logout-form" asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="header-login-link header-logout-button">تسجيل الخروج</button>
                            </form>
                        }
                        else
                        {
                            <a class="header-login-link" asp-area="" asp-controller="Account" asp-action="Register">إنشاء حساب</a>
                            <a class="header-login-link" asp-area="" asp-controller="Account" asp-action="Login">تسجيل الدخول</a>
                        }
                        <a class="icon-link" asp-area="" asp-controller="Wishlist" asp-action="Index" aria-label="المفضلة">♡</a>
                        <a class="icon-link cart-icon-link" asp-area="" asp-controller="Cart" asp-action="Index"
                           aria-label="سلة المشتريات" title="سلة المشتريات"><svg viewBox="0 0 24 24" width="21" height="21"
                                                                              aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
                                                                              stroke-linejoin="round">
                            <path d="M3 4h2l2.2 10.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 1.9-1.4L21 8H6" />
                            <circle cx="10" cy="20" r="1" />
                            <circle cx="18" cy="20" r="1" />
                        </svg></a>
                    </div>
                </div>
                <nav class="nav" aria-label="القائمة الرئيسية">
                    <div class="container nav-inner">
                        <a asp-area="" asp-controller="Home" asp-action="Index">الرئيسية</a>
                        <a asp-area="" asp-controller="Store" asp-action="Index">كل المنتجات</a>
                        <a asp-area="" asp-controller="Home" asp-action="Contact">تواصل معنا</a>
                        <a asp-area="" asp-controller="Home" asp-action="Faq">الأسئلة الشائعة</a>
                    </div>
                </nav>
            </header>
            <main>
                @if (TempData["Success"] is string successMessage)
                {
                    <div class="container">
                        <div class="status">@successMessage</div>
                    </div>
                }
                @if (TempData["Error"] is string errorMessage)
                {
                    <div class="container">
                        <div class="status error">@errorMessage</div>
                    </div>
                }
                @RenderBody()
            </main>
            <footer class="footer">
                <div class="container">
                    <div class="footer-grid">
                        <div><a class="brand" asp-area="" asp-controller="Home" asp-action="Index"><img
                            src="~/assets/brand-mark.svg" alt="شعار عِدّة" /><span><span
                            class="brand-name">عِدّة</span><span class="brand-tag">تقنيتك تبدأ من
                            هنا</span></span></a>
                            <p>وجهتك لاختيار أجهزة الكمبيوتر واللابتوبات والإكسسوارات التقنية بثقة وسهولة.</p>
                        </div>
                        <div>
                            <h4>تسوّق</h4><a asp-area="" asp-controller="Store" asp-action="Index">كل المنتجات</a><a asp-area=""
                                                                                                                     asp-controller="Cart" asp-action="Index">سلة المشتريات</a>
                        </div>
                        <div>
                            <h4>خدمة العملاء</h4><a asp-area="" asp-controller="Home" asp-action="Contact">تواصل معنا</a><a
                            asp-area="" asp-controller="Home" asp-action="Faq">الأسئلة الشائعة</a><a asp-area=""
                                                                                                     asp-controller="Home" asp-action="Privacy">سياسة الخصوصية</a>
                        </div>
                        <div>
                            <h4>حسابك</h4><a asp-area="" asp-controller="Account" asp-action="Index">حسابي وطلباتي</a><a
                            asp-area="" asp-controller="Wishlist" asp-action="Index">المفضلة</a><a class="footer-whatsapp"
                                                                                                   href="@whatsappUrl" target="_blank" rel="noopener noreferrer">تواصل عبر واتساب: 01002270587</a>
                        </div>
                    </div>
                    <div class="copyright"><span>© @DateTime.Now.Year عِدّة EDDA</span><span>متجر الكمبيوتر واللابتوب
                        والإكسسوارات.</span></div>
                    </div>
                </footer>
                <a class="whatsapp-float" href="@whatsappUrl" target="_blank" rel="noopener noreferrer"
                   aria-label="تواصل مع عِدّة عبر واتساب على الرقم 01002270587" title="واتساب 01002270587"><svg viewBox="0 0 24 24"
                                                                                                             aria-hidden="true">
                    <path
                    d="M12.04 2a9.8 9.8 0 0 0-8.36 14.91L2.3 22l5.22-1.36A9.96 9.96 0 0 0 12.04 21h.01A9.5 9.5 0 0 0 21.6 11.5 9.56 9.56 0 0 0 12.04 2Zm0 17.2h-.01a8.1 8.1 0 0 1-4.12-1.13l-.3-.18-3.1.81.83-3.02-.2-.31a7.8 7.8 0 1 1 6.9 3.83Zm4.29-5.84c-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2-.72-.64-1.2-1.43-1.34-1.67-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.46-.4-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.64.58.25 1.04.4 1.4.51.59.19 1.13.16 1.55.1.47-.07 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z" />
                </svg><span class="whatsapp-tooltip">واتساب <b dir="ltr">01002270587</b></span></a>
                <script src="~/js/site.js" asp-append-version="true"></script>
                @await RenderSectionAsync("StructuredData", required: false)
                @await RenderSectionAsync("Scripts", required: false)
            </body>

        </html>
