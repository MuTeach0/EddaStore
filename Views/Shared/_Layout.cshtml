<!doctype html>
<html lang="ar" dir="rtl">
@{
    var pageTitle = ViewData["Title"] as string;
    var fullTitle = string.IsNullOrWhiteSpace(pageTitle) ? "عِدّة | تقنيتك تبدأ من هنا" : $"{pageTitle} | عِدّة";
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#26372D" />
    <title>@fullTitle</title>
    <link rel="icon" href="~/assets/brand-mark.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/assets/styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="announcement">شحن سريع على منتجات مختارة <b>—</b> تجربة شراء أسهل مع عِدّة</div>
    <header class="header">
        <div class="container header-main">
            <a class="brand" asp-area="" asp-controller="Home" asp-action="Index" aria-label="الصفحة الرئيسية">
                <img src="~/assets/brand-mark.svg" alt="شعار عِدّة" />
                <span><span class="brand-name">عِدّة</span><span class="brand-tag">تقنيتك تبدأ من هنا</span></span>
            </a>
            <form class="search" asp-area="" asp-controller="Store" asp-action="Index" method="get" role="search">
                <input type="search" name="q" value="@Context.Request.Query["q"]" placeholder="بتدور على إيه؟ لابتوب، شاشة، إكسسوارات..." aria-label="ابحث عن منتج" />
            </form>
            <div class="header-actions">
                @if (User.IsInRole("Admin"))
                {
                    <a class="header-admin-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">▦ <span>لوحة التحكم</span></a>
                }
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="icon-link" asp-area="" asp-controller="Account" asp-action="Index" aria-label="حسابي">♙</a>
                    <form class="logout-form" asp-area="Identity" asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
                        <button type="submit" class="header-login-link header-logout-button">تسجيل الخروج</button>
                    </form>
                }
                else
                {
                    <a class="header-login-link" asp-area="Identity" asp-page="/Account/Register">إنشاء حساب</a>
                    <a class="header-login-link" asp-area="Identity" asp-page="/Account/Login">تسجيل الدخول</a>
                }
                <a class="icon-link" asp-area="" asp-controller="Wishlist" asp-action="Index" aria-label="المفضلة">♡</a>
                <a class="icon-link" asp-area="" asp-controller="Cart" asp-action="Index" aria-label="السلة">🛒</a>
            </div>
        </div>
        <nav class="nav" aria-label="القائمة الرئيسية"><div class="container nav-inner">
            <a asp-area="" asp-controller="Home" asp-action="Index">الرئيسية</a>
            <a asp-area="" asp-controller="Store" asp-action="Index">كل المنتجات</a>
            <a asp-area="" asp-controller="Store" asp-action="Index">الأقسام</a>
            <a asp-area="" asp-controller="Store" asp-action="Index" asp-route-category="laptops">لابتوبات</a>
            <a asp-area="" asp-controller="Store" asp-action="Index" asp-route-category="gaming">Gaming</a>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">عن عِدّة</a>
            <a asp-area="" asp-controller="Home" asp-action="Contact">تواصل معنا</a>
            <a asp-area="" asp-controller="Home" asp-action="Faq">الأسئلة الشائعة</a>
        </div></nav>
    </header>
    <main>
        @if (TempData["Success"] is string successMessage) { <div class="container"><div class="status">@successMessage</div></div> }
        @if (TempData["Error"] is string errorMessage) { <div class="container"><div class="status error">@errorMessage</div></div> }
        @RenderBody()
    </main>
    <footer class="footer"><div class="container"><div class="footer-grid">
        <div><a class="brand" asp-area="" asp-controller="Home" asp-action="Index"><img src="~/assets/brand-mark.svg" alt="شعار عِدّة" /><span><span class="brand-name">عِدّة</span><span class="brand-tag">تقنيتك تبدأ من هنا</span></span></a><p>وجهتك لاختيار أجهزة الكمبيوتر واللابتوبات والإكسسوارات التقنية بثقة وسهولة.</p></div>
        <div><h4>تسوّق</h4><a asp-area="" asp-controller="Store" asp-action="Index">كل المنتجات</a><a asp-area="" asp-controller="Store" asp-action="Index">الأقسام</a><a asp-area="" asp-controller="Cart" asp-action="Index">سلة المشتريات</a></div>
        <div><h4>خدمة العملاء</h4><a asp-area="" asp-controller="Home" asp-action="Privacy">سياسة الخصوصية</a><a asp-area="" asp-controller="Account" asp-action="Index">حسابي</a></div>
        <div><h4>عن عِدّة</h4><a asp-area="" asp-controller="Home" asp-action="Privacy">قصتنا</a><p>الأحد – الخميس<br />10 ص إلى 10 م</p></div>
    </div><div class="copyright"><span>© @DateTime.Now.Year عِدّة EDDA</span><span>صُممت بعناية وبهوية عِدّة.</span></div></div></footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
