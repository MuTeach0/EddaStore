@using EddaStore.Models.Identity
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
<div class="header-actions" aria-label="إجراءات الحساب">
    @if (SignInManager.IsSignedIn(User))
    {
        <a class="header-login-link" asp-controller="Account" asp-action="Index">حسابي</a>
        <form class="logout-form" asp-controller="Account" asp-action="Logout" method="post">
            <button type="submit" class="header-login-link header-logout-button">تسجيل الخروج</button>
        </form>
    }
    else
    {
        <a class="header-login-link" asp-controller="Account" asp-action="Register">إنشاء حساب</a>
        <a class="header-login-link" asp-controller="Account" asp-action="Login">تسجيل الدخول</a>
    }
</div>
