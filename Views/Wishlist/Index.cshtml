@model IReadOnlyList<EddaStore.Models.Customers.WishlistItem>
@{
    ViewData["Title"] = "المفضلة"; ViewData["Robots"] = "noindex, follow";
}
<section class="page-head">
    <div class="container">
        <div class="breadcrumbs"><a asp-controller="Home" asp-action="Index">الرئيسية</a> / المفضلة</div>
        <h1>المفضلة</h1>
        <p>منتجاتك المحفوظة مرتبطة بحسابك.</p>
    </div>
</section>
<div class="container section">@if(!Model.Any()){
    <div class="empty">
        <div class="empty-icon">♡</div>
        <h2>لا توجد منتجات محفوظة</h2><a class="btn btn-primary" asp-controller="Store" asp-action="Index">اكتشف
        المنتجات</a>
    </div>
}else
{

    <div class="product-grid">@foreach(var item in Model){var
        image = item.Product.Images.OrderByDescending(x => x.IsPrimary).ThenBy(x =>
        x.SortOrder).FirstOrDefault()?.ImageUrl;
        <article class="product-card">@if(image is not null){
            <img src="@image" alt="@item.Product.Name" />
        }
        <h3><a asp-controller="Store" asp-action="Details"
                   asp-route-slug="@item.Product.Slug">@item.Product.Name</a></h3><strong
            class="price">@item.Product.Price.ToString("N0") ج.م</strong>
            <div class="card-actions">
                <form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="productId"
                                                                                      value="@item.ProductId" /><input type="hidden" name="returnUrl"
                                                     value="@Url.Action("Index")" /><button class="btn btn-primary" type="submit">أضف للسلة</button>
                </form>
                <form asp-action="Remove" method="post"><input type="hidden" name="productId"
                                                                   value="@item.ProductId" /><button class="text-link" type="submit">حذف</button></form>
                </div>
            </article>
        }
    </div>
}
</div>