@model EddaStore.Models.ViewModels.Store.CheckoutPageViewModel
@{ ViewData["Title"] = "إتمام الطلب"; }
<section class="page-head"><div class="container"><div class="breadcrumbs"><a asp-controller="Cart" asp-action="Index">السلة</a> / إتمام الطلب</div><h1>بيانات الشحن والدفع</h1><p>الدفع عند الاستلام فقط. الشحن مجاني حاليًا.</p></div></section>
<div class="container section cart-layout"><form asp-action="Index" method="post" class="panel checkout-form"><h2>عنوان الشحن</h2><div asp-validation-summary="ModelOnly" class="validation-message"></div><input asp-for="Input.CheckoutToken" type="hidden"/><div class="form-grid"><label>الاسم المستلم<input asp-for="Input.RecipientName"/></label><label>رقم الهاتف<input asp-for="Input.PhoneNumber" inputmode="tel"/></label><label>المدينة<input asp-for="Input.City"/></label><label>العنوان بالتفصيل<input asp-for="Input.StreetAddress"/></label><label>المبنى<input asp-for="Input.Building"/></label><label>الشقة<input asp-for="Input.Apartment"/></label><label>الرمز البريدي<input asp-for="Input.PostalCode"/></label><label>كوبون الخصم<input asp-for="Input.CouponCode"/></label></div><button class="btn btn-primary" type="submit">تأكيد الطلب والدفع عند الاستلام</button></form><aside class="panel"><h2>ملخص الطلب</h2>@foreach(var item in Model.Cart.Items){<div class="summary-line"><span>@item.Name × @item.Quantity</span><strong>@item.LineTotal.ToString("N0") ج.م</strong></div>}<div class="summary-line summary-total"><span>الإجمالي قبل الكوبون</span><strong>@Model.Cart.Subtotal.ToString("N0") ج.م</strong></div></aside></div>
