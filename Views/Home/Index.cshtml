@model EddaStore.Models.ViewModels.HomeViewModel
@{ ViewData["Title"] = "الرئيسية"; }
<div class="container">
    <section class="hero"><div class="hero-copy"><span class="eyebrow">عِدّة — تقنيتك تبدأ من هنا</span><h1>كل اللي تحتاجه<br />لعالمك التقني.</h1><p>من اللابتوب اللي ينجز شغلك، لحد الإكسسوارات اللي تكمّل تجربتك. اختار بثقة وخلّي التقنية أقرب ليك.</p><div style="display:flex;gap:10px;flex-wrap:wrap"><a class="btn btn-primary" asp-controller="Store" asp-action="Index">اكتشف المنتجات ←</a><a class="btn btn-outline" asp-controller="Store" asp-action="Index">تصفح الأقسام</a></div></div><div class="hero-image" role="img" aria-label="أجهزة تقنية من عِدّة"></div></section>
    <section class="section"><div class="section-head"><div><span class="eyebrow">تصفّح بسهولة</span><h2>تسوّق حسب التصنيف</h2><p>كل ما تحتاجه في مكان واحد.</p></div><a class="text-link" asp-controller="Store" asp-action="Index">عرض الكل ←</a></div>
        @if (Model.Categories.Count > 0) { <div class="categories">@foreach (var category in Model.Categories) { <a class="category-card" asp-controller="Store" asp-action="Index" asp-route-category="@category.Slug"><span class="category-icon">✦</span><span><strong>@category.Name</strong><small>اكتشف المنتجات</small></span></a> }</div> }
    </section>
    <section class="section"><div class="section-head"><div><span class="eyebrow">اختياراتنا ليك</span><h2>منتجات تستحق التجربة</h2><p>منتجات متاحة ومختارة بعناية.</p></div><a class="text-link" asp-controller="Store" asp-action="Index">كل المنتجات ←</a></div>
        @if (Model.FeaturedProducts.Count > 0) { <div class="product-grid">@foreach (var product in Model.FeaturedProducts) { var image = product.Images.FirstOrDefault(); <article class="product-card"><a class="product-photo" asp-controller="Store" asp-action="Details" asp-route-slug="@product.Slug">@if (!string.IsNullOrWhiteSpace(image?.ImageUrl)) { <img src="@image.ImageUrl" alt="@(image?.AltText ?? product.Name)" loading="lazy" /> } else { <span class="tag">قريبًا</span> }</a><button class="heart" type="button" aria-label="أضف للمفضلة">♡</button><div class="product-info"><div class="product-brand">@product.Brand?.Name</div><a class="product-title" asp-controller="Store" asp-action="Details" asp-route-slug="@product.Slug">@product.Name</a><div class="rating">★ منتج مختار</div><div class="price-row"><span class="price">@product.Price.ToString("N0") ج.م</span>@if(product.CompareAtPrice > product.Price){<span class="old-price">@product.CompareAtPrice?.ToString("N0") ج.م</span>}</div><div class="product-bottom"><a class="btn btn-primary" asp-controller="Store" asp-action="Details" asp-route-slug="@product.Slug">أضف للسلة</a><a class="btn btn-outline" asp-controller="Store" asp-action="Details" asp-route-slug="@product.Slug">التفاصيل</a></div></div></article> }</div> } else { <div class="empty"><div class="empty-icon">⌁</div><h2>لا توجد منتجات متاحة</h2><p>أضف منتجات نشطة لتظهر هنا.</p></div> }
    </section>
    <section class="trust-row"><div class="trust-item"><span>🚚</span><div><strong>شحن سريع</strong><small>توصيل آمن وسهل</small></div></div><div class="trust-item"><span>✓</span><div><strong>اختيار واضح</strong><small>تفاصيل تساعدك تقرر</small></div></div><div class="trust-item"><span>↺</span><div><strong>تجربة مرنة</strong><small>تسوّق براحتك</small></div></div><div class="trust-item"><span>🔒</span><div><strong>تسوّق بثقة</strong><small>بياناتك في أمان</small></div></div></section>
</div>
