@model EddaStore.Models.ViewModels.Identity.RegisterViewModel
@{
    ViewData["Title"] = "إنشاء حساب"; ViewData["Robots"] = "noindex, follow";
}
<section class="account-page">
    <div class="container account-wrap">
        <nav class="account-breadcrumb" aria-label="مسار الصفحة"><a asp-controller="Home"
                                                                        asp-action="Index">الرئيسية</a><span> / </span><span>إنشاء حساب</span></nav>
            <div class="auth-layout auth-layout-register">
                <section class="auth-panel">
                    <div class="auth-heading"><span class="auth-eyebrow">أهلًا بيك في عِدّة</span>
                        <h1>خلّي تجربتك أسهل</h1>
                        <p>أنشئ حسابك في خطوات بسيطة عشان تتابع طلباتك وتحفظ اختياراتك.</p>
                    </div>
                    <div asp-validation-summary="ModelOnly" class="account-validation-summary"></div>
                    <form asp-action="Register" method="post" class="account-form">
                        <div class="form-two-columns">
                            <div class="form-field"><label asp-for="FirstName"></label><input asp-for="FirstName"
                                                                                                  class="account-input" autocomplete="given-name" placeholder="الاسم الأول" /><span
                                asp-validation-for="FirstName" class="account-field-error"></span></div>
                                <div class="form-field"><label asp-for="LastName"></label><input asp-for="LastName"
                                                                                                     class="account-input" autocomplete="family-name" placeholder="اسم العائلة" /><span
                                    asp-validation-for="LastName" class="account-field-error"></span></div>
                                </div>
                                <div class="form-field"><label asp-for="Email"></label><input asp-for="Email" class="account-input"
                                                                                                  type="email" autocomplete="email" placeholder="name@example.com" /><span
                                    asp-validation-for="Email" class="account-field-error"></span></div>
                                    <div class="form-field"><label asp-for="Password"></label><input asp-for="Password"
                                                                                                         class="account-input" autocomplete="new-password" placeholder="أنشئ كلمة مرور قوية" /><span
                                        asp-validation-for="Password" class="account-field-error"></span><small
                                        class="field-hint">استخدم كلمة مرور قوية يصعب تخمينها.</small></div>
                                        <div class="form-field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword"
                                                                                                                    class="account-input" autocomplete="new-password"
                                                                                                                    placeholder="اكتب كلمة المرور مرة أخرى" /><span asp-validation-for="ConfirmPassword"
                                                                                            class="account-field-error"></span></div>
                                            <button class="account-primary-button" type="submit">إنشاء الحساب <span
                                                aria-hidden="true">←</span></button>
                                            </form>
                                            <p class="auth-switch">عندك حساب بالفعل؟ <a asp-action="Login">سجّل دخولك</a></p>
                                            <div class="auth-security-note"><span aria-hidden="true">✓</span> إنشاء الحساب يعني موافقتك على استخدام
                                                بياناتك لتجربة المتجر.</div>
                                            </section>
                                            <aside class="auth-showcase auth-showcase-register">
                                                <div class="showcase-topline"><span class="showcase-logo">عِدّة</span><span class="showcase-en">EDDA
                                                    STORE</span></div>
                                                    <div class="showcase-copy"><span class="showcase-pill"><i></i> حسابك في مكان واحد</span>
                                                        <h2>تسوّق بذكاء،<br /><em>واختار براحتك.</em></h2>
                                                        <p>حسابك بيجمع طلباتك وعناوين الشحن والمنتجات اللي حابب ترجع لها.</p>
                                                        <div class="register-benefit-list">
                                                            <div><span>✓</span> متابعة الطلبات بسهولة</div>
                                                            <div><span>✓</span> حفظ المنتجات المفضلة</div>
                                                            <div><span>✓</span> إدارة بياناتك وعناوينك</div>
                                                        </div>
                                                    </div>
                                                    <div class="showcase-orbit orbit-one"></div>
                                                    <div class="showcase-orbit orbit-two"></div>
                                                    <div class="showcase-bottom">اختيارك التقني يبدأ بخطوة <span>✳</span></div>
                                                </aside>
                                            </div>
                                        </div>
                                    </section>
                                    @section Scripts {
                                        <partial name="_ValidationScriptsPartial" />
                                    }