@model EddaStore.Models.ViewModels.Identity.ForgotPasswordViewModel
@{
    ViewData["Title"] = "استعادة كلمة المرور"; ViewData["Robots"] = "noindex, follow";
}
<section class="account-page">
    <div class="container account-wrap">
        <nav class="account-breadcrumb"><a asp-controller="Home" asp-action="Index">الرئيسية</a><span> / </span><a
            asp-action="Login">تسجيل الدخول</a><span> / </span><span>استعادة كلمة المرور</span></nav>
            <div class="auth-layout auth-layout-compact">
                <section class="auth-panel">
                    <div class="auth-icon-bubble" aria-hidden="true">↻</div>
                    <div class="auth-heading"><span class="auth-eyebrow">استعادة الوصول</span>
                        <h1>نسيت كلمة المرور؟</h1>
                        <p>ولا يهمك. اكتب البريد الإلكتروني المرتبط بحسابك، وهنوضح لك الخطوة التالية.</p>
                    </div>
                    @if (TempData["ErrorMessage"] is string error)
                    {
                        <div class="account-alert account-alert-error"
                             role="alert">@error</div>
                    }
                    <div asp-validation-summary="ModelOnly"
                         class="account-validation-summary"></div>
                    <form asp-action="ForgotPassword" method="post" class="account-form">
                        <div class="form-field"><label asp-for="Email"></label><input asp-for="Email" class="account-input"
                                                                                          type="email" autocomplete="email" placeholder="name@example.com" /><span
                            asp-validation-for="Email" class="account-field-error"></span></div><button
                            class="account-primary-button" type="submit">إرسال رابط الاستعادة <span
                            aria-hidden="true">←</span></button>
                        </form>
                        <p class="auth-switch"><a asp-action="Login">العودة لتسجيل الدخول</a></p>
                        <div class="auth-security-note"><span aria-hidden="true">i</span> لأمان حسابك، لن نكشف ما إذا كان البريد
                            مسجلًا لدينا.</div>
                        </section>
                        <aside class="auth-showcase auth-showcase-compact">
                            <div class="showcase-topline"><span class="showcase-logo">عِدّة</span><span class="showcase-en">ACCOUNT
                                HELP</span></div>
                                <div class="showcase-copy"><span class="showcase-pill"><i></i> إحنا معاك</span>
                                    <h2>استرجع حسابك<br /><em>بخطوات بسيطة.</em></h2>
                                    <p>اتبع التعليمات اللي هتوصلك على بريدك الإلكتروني لتعيين كلمة مرور جديدة.</p>
                                </div>
                                <div class="showcase-orbit orbit-one"></div>
                                <div class="showcase-orbit orbit-two"></div>
                                <div class="showcase-bottom">حسابك يهمّنا <span>✳</span></div>
                            </aside>
                        </div>
                    </div>
                </section>
                @section Scripts {
                    <partial name="_ValidationScriptsPartial" />
                }