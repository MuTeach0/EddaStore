@model EddaStore.Models.Orders.Order
@{ ViewData["Title"] = "تفاصيل الطلب"; }
<section class="page-head"><div class="container"><div class="breadcrumbs"><a asp-action="Index">حسابي</a> / @Model.OrderNumber</div><h1>طلب @Model.OrderNumber</h1><p>الحالة: @Model.Status</p></div></section><div class="container section"><section class="panel"><h2>المنتجات</h2><div class="table-wrap"><table><thead><tr><th>المنتج</th><th>الكمية</th><th>السعر</th><th>الإجمالي</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td>@item.ProductName</td><td>@item.Quantity</td><td>@item.UnitPrice.ToString("N0") ج.م</td><td>@item.LineTotal.ToString("N0") ج.م</td></tr>}</tbody></table></div><div class="summary-line summary-total"><span>إجمالي الطلب</span><strong>@Model.TotalAmount.ToString("N0") ج.م</strong></div></section></div>
