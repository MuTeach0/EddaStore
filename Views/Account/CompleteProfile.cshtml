@model EddaStore.Models.ViewModels.Identity.CompleteProfileViewModel
@{
    ViewData["Title"] = "إكمال بيانات الحساب"; ViewData["Robots"] = "noindex, follow";
}
<section class="account-page">
    <div class="container account-wrap">
        <div class="auth-layout auth-layout-compact">
            <section class="auth-panel">
                <div class="auth-icon-bubble" aria-hidden="true">＋</div>
                <div class="auth-heading"><span class="auth-eyebrow">خطوة أخيرة</span>
                    <h1>كمّل بيانات حسابك</h1>
                    <p>أضف رقم موبايل مصري عشان نسهّل متابعة طلباتك والتواصل بخصوص الشحن.</p>
                </div>
                <div asp-validation-summary="ModelOnly" class="account-validation-summary"></div>
                <form asp-action="CompleteProfile" method="post" class="account-form">
                    <div class="form-field"><label asp-for="PhoneNumber"></label><input asp-for="PhoneNumber"
                                                                                            class="account-input" type="tel" inputmode="tel" placeholder="01xxxxxxxxx"
                                                                                            autocomplete="tel" /><span asp-validation-for="PhoneNumber"
                                                   class="account-field-error"></span><small class="field-hint">تقدر تكتب الرقم بصيغة
                        01xxxxxxxxx أو +20xxxxxxxxxx.</small></div><button class="account-primary-button"
                                                                           type="submit">حفظ ومتابعة التسوق <span aria-hidden="true">←</span></button>
                    </form>
                    <div class="auth-security-note"><span aria-hidden="true">✓</span> أدخل رقمًا صحيحًا يمكن التواصل معك من
                        خلاله عند الحاجة.</div>
                    </section>
                    <aside class="auth-showcase auth-showcase-compact">
                        <div class="showcase-topline"><span class="showcase-logo">عِدّة</span><span class="showcase-en">ONE LAST
                            STEP</span></div>
                            <div class="showcase-copy"><span class="showcase-pill"><i></i> قربت تخلص</span>
                                <h2>بياناتك كاملة،<br /><em>تجربتك أسهل.</em></h2>
                                <p>بعد حفظ الرقم، تقدر تكمل تصفح المنتجات ومتابعة مشترياتك.</p>
                            </div>
                            <div class="showcase-orbit orbit-one"></div>
                            <div class="showcase-orbit orbit-two"></div>
                            <div class="showcase-bottom">عِدّة معاك <span>✳</span></div>
                        </aside>
                    </div>
                </div>
            </section>
            @section Scripts {
                <partial name="_ValidationScriptsPartial" />
            }