@model EddaStore.Models.ViewModels.Store.AccountViewModel
@{ ViewData["Title"] = "حسابي"; }
<section class="page-head"><div class="container"><div class="breadcrumbs"><a asp-controller="Home" asp-action="Index">الرئيسية</a> / حسابي</div><h1>حسابي</h1><p>@Model.Email</p></div></section>
<div class="container section account-layout"><nav class="side-nav"><a class="active" asp-action="Index">نظرة عامة</a><a asp-controller="Wishlist" asp-action="Index">المفضلة</a><a asp-controller="Cart" asp-action="Index">سلة المشتريات</a><a asp-area="Identity" asp-page="/Account/Manage/Index">إعدادات الهوية</a></nav><div><section class="panel"><h2>ملخص الحساب</h2><div class="stat-grid"><div class="stat"><strong>@Model.Orders.Count</strong><span>إجمالي الطلبات</span></div><div class="stat"><strong>@Model.Orders.Count(x=>x.Status is "Pending" or "Processing" or "Shipped")</strong><span>طلبات قيد التنفيذ</span></div><div class="stat"><strong>@Model.WishlistCount</strong><span>المنتجات المفضلة</span></div></div></section><section class="panel"><h2>طلباتي</h2>@if(!Model.Orders.Any()){<p class="muted">لا توجد طلبات حتى الآن.</p>}else{<div class="table-wrap"><table><thead><tr><th>رقم الطلب</th><th>التاريخ</th><th>الحالة</th><th>الإجمالي</th><th></th></tr></thead><tbody>@foreach(var order in Model.Orders){<tr><td>@order.OrderNumber</td><td>@order.PlacedAt?.ToLocalTime().ToString("yyyy/MM/dd")</td><td>@order.Status</td><td>@order.TotalAmount.ToString("N0") ج.م</td><td><a asp-action="Details" asp-route-id="@order.Id">التفاصيل</a></td></tr>}</tbody></table></div>}</section><section class="panel"><h2>عناوين الشحن</h2>@if(Model.Addresses.Any()){<ul>@foreach(var address in Model.Addresses){<li>@address.FullName — @address.City، @address.StreetAddress</li>}</ul>}<form asp-action="AddAddress" method="post" class="form-grid"><label>الاسم<input name="FullName" required/></label><label>الهاتف<input name="PhoneNumber" required/></label><label>المدينة<input name="City" required/></label><label>العنوان<input name="StreetAddress" required/></label><label><input type="checkbox" name="IsDefault" value="true"/> عنوان افتراضي</label><button class="btn btn-outline" type="submit">إضافة عنوان</button></form></section></div></div>
