@model EddaStore.Models.ViewModels.Identity.ResetPasswordViewModel
@{
    ViewData["Title"] = "تعيين كلمة مرور جديدة"; ViewData["Robots"] = "noindex, follow";
}
<section class="account-page">
    <div class="container account-wrap">
        <nav class="account-breadcrumb"><a asp-controller="Home" asp-action="Index">الرئيسية</a><span> /
        </span><span>كلمة مرور جديدة</span></nav>
        <div class="auth-layout auth-layout-compact">
            <section class="auth-panel">
                <div class="auth-icon-bubble" aria-hidden="true">⌁</div>
                <div class="auth-heading"><span class="auth-eyebrow">تأمين حسابك</span>
                    <h1>اختار كلمة مرور جديدة</h1>
                    <p>خليها قوية ومختلفة عن كلمات المرور اللي بتستخدمها في مواقع تانية.</p>
                </div>
                <div asp-validation-summary="ModelOnly" class="account-validation-summary"></div>
                <form asp-action="ResetPassword" method="post" class="account-form"><input asp-for="Email"
                                                                                               type="hidden" /><input asp-for="Token" type="hidden" />
                    <div class="form-field"><label asp-for="Password"></label><input asp-for="Password"
                                                                                         class="account-input" autocomplete="new-password" placeholder="كلمة المرور الجديدة" /><span
                        asp-validation-for="Password" class="account-field-error"></span></div>
                        <div class="form-field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword"
                                                                                                    class="account-input" autocomplete="new-password"
                                                                                                    placeholder="أكد كلمة المرور الجديدة" /><span asp-validation-for="ConfirmPassword"
                                                                          class="account-field-error"></span></div><button class="account-primary-button"
                                                                             type="submit">حفظ كلمة المرور <span aria-hidden="true">←</span></button>
                        </form>
                        <p class="auth-switch"><a asp-action="Login">العودة لتسجيل الدخول</a></p>
                    </section>
                    <aside class="auth-showcase auth-showcase-compact">
                        <div class="showcase-topline"><span class="showcase-logo">عِدّة</span><span class="showcase-en">ACCOUNT
                            SECURITY</span></div>
                            <div class="showcase-copy"><span class="showcase-pill"><i></i> حماية حسابك</span>
                                <h2>كلمة مرور قوية،<br /><em>حساب أكثر أمانًا.</em></h2>
                                <p>استخدم مزيجًا من الحروف والأرقام والرموز إذا كانت شروط الحساب تسمح بذلك.</p>
                            </div>
                            <div class="showcase-orbit orbit-one"></div>
                            <div class="showcase-orbit orbit-two"></div>
                            <div class="showcase-bottom">الأمان يبدأ منك <span>✳</span></div>
                        </aside>
                    </div>
                </div>
            </section>
            @section Scripts {
                <partial name="_ValidationScriptsPartial" />
            }