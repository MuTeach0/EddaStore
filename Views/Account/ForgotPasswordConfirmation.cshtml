@{
    ViewData["Title"] = "خطوات استعادة كلمة المرور"; ViewData["Robots"] = "noindex, follow";
}
<section class="account-page">
    <div class="container account-wrap">
        <div class="auth-layout auth-layout-compact">
            <section class="auth-panel auth-result-panel">
                <div class="result-icon" aria-hidden="true">✓</div><span class="auth-eyebrow">تم استلام طلبك</span>
                <h1>راجع بريدك الإلكتروني</h1>
                <p class="result-description">@ViewBag.Message</p>
                <div class="result-steps">
                    <div><span>1</span>
                        <p>افتح البريد الإلكتروني المرتبط بحسابك.</p>
                    </div>
                    <div><span>2</span>
                        <p>لو كان البريد مسجلًا، هتلاقي رسالة فيها رابط آمن للاستعادة.</p>
                    </div>
                    <div><span>3</span>
                        <p>افتح الرابط وحدد كلمة مرور جديدة.</p>
                    </div>
                </div><a class="account-primary-button account-button-link" asp-action="Login">العودة لتسجيل الدخول
                <span aria-hidden="true">←</span></a>
                <p class="result-note">مش لاقي الرسالة؟ راجع مجلد الرسائل غير المرغوب فيها.</p>
            </section>
            <aside class="auth-showcase auth-showcase-compact">
                <div class="showcase-topline"><span class="showcase-logo">عِدّة</span><span class="showcase-en">ACCOUNT
                    HELP</span></div>
                    <div class="showcase-copy"><span class="showcase-pill"><i></i> خطوة بخطوة</span>
                        <h2>أمان حسابك<br /><em>أولوية عندنا.</em></h2>
                        <p>لن نطلب منك مشاركة كلمة المرور مع أي شخص. استخدم رابط الاستعادة الآمن فقط.</p>
                    </div>
                    <div class="showcase-orbit orbit-one"></div>
                    <div class="showcase-orbit orbit-two"></div>
                    <div class="showcase-bottom">تقنيتك تبدأ من هنا <span>✳</span></div>
                </aside>
            </div>
        </div>
    </section>