@page
@model EddaStore.Areas.Identity.Pages.Account.LoginModel
@{ViewData["Title"]="تسجيل الدخول";}
<h1>مرحبًا بعودتك</h1><p>سجّل الدخول للوصول إلى حسابك.</p><form method="post" class="auth-form"><input type="hidden" asp-for="Input.ReturnUrl"/><div asp-validation-summary="ModelOnly" class="auth-validation"></div>@if(Model.ErrorMessage is not null){<div class="auth-validation">@Model.ErrorMessage</div>}<div class="auth-field"><label asp-for="Input.Email"></label><input asp-for="Input.Email" dir="ltr" autocomplete="email"/><span asp-validation-for="Input.Email" class="auth-validation"></span></div><div class="auth-field"><label asp-for="Input.Password"></label><input asp-for="Input.Password" dir="ltr" autocomplete="current-password"/><span asp-validation-for="Input.Password" class="auth-validation"></span></div><label class="auth-links"><span><input asp-for="Input.RememberMe"/> تذكرني</span><a asp-page="ForgotPassword">نسيت كلمة المرور؟</a></label><button class="auth-primary" type="submit">تسجيل الدخول</button></form>@if(Model.ShowGoogle){<form method="post" asp-page-handler="ExternalLogin" class="auth-form" style="margin-top:12px"><input type="hidden" name="returnUrl" value="@Model.Input.ReturnUrl"/><button class="auth-google" name="provider" value="Google" type="submit">المتابعة باستخدام Google</button></form>}<p class="auth-note">ليس لديك حساب؟ <a asp-page="Register" asp-route-returnUrl="@Model.Input.ReturnUrl">أنشئ حسابًا جديدًا</a></p>
