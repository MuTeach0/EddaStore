@{
    ViewData["Title"] = "ملخص التنبيهات"; ViewData["Heading"] = "ملخص التنبيهات";
}
<div class="page-head">
    <div>
        <div class="eyebrow">عِدّة / لوحة الإدارة</div>
        <h1>ملخص التنبيهات</h1>
        <p>راجع الطلبات المعلقة والمخزون المنخفض والتقييمات التي تنتظر المراجعة.</p>
    </div>
</div>
<div class="grid two-col">
    <section class="panel">
        <div class="panel-head">
            <div>
                <h2>ما يحتاج إلى متابعة</h2>
                <p>الأعداد الحالية من بيانات المتجر.</p>
            </div>
        </div>
        <div class="activity">
            <div class="activity-item"><span class="activity-icon" aria-hidden="true">▧</span>
                <div>
                    <p><b>@ViewBag.PendingOrders طلب بانتظار المعالجة</b></p><small>راجع تفاصيل الطلب وحدّث حالته عند
                    الحاجة.</small>
                </div>
            </div>
            <div class="activity-item"><span class="activity-icon" aria-hidden="true">!</span>
                <div>
                    <p><b>@ViewBag.LowStock منتج بمخزون منخفض</b></p><small>المنتجات التي يتراوح مخزونها بين 1 و5
                    وحدات.</small>
                </div>
            </div>
            <div class="activity-item"><span class="activity-icon" aria-hidden="true">☆</span>
                <div>
                    <p><b>@ViewBag.PendingReviews مراجعة بانتظار الاعتماد</b></p><small>راجع المحتوى قبل إظهاره
                    للعملاء.</small>
                </div>
            </div>
        </div>
    </section>
    <section class="panel">
        <div class="panel-head">
            <div>
                <h2>إجراءات مباشرة</h2>
                <p>انتقل إلى القسم المرتبط بكل تنبيه.</p>
            </div>
        </div>
        <div class="quick-actions"><a class="btn primary" asp-controller="Orders" asp-action="Index">مراجعة
            الطلبات</a><a class="btn" asp-controller="Tools" asp-action="Inventory">فتح المخزون</a><a class="btn"
                                                                                                      asp-controller="Reviews" asp-action="Index">مراجعة التقييمات</a></div>
        </section>
    </div>