@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityRole<Guid>>
@{ ViewData["Title"]="الأدوار والصلاحيات"; ViewData["Heading"]="الأدوار والصلاحيات"; }
<div class="page-head"><div><div class="eyebrow">عِدّة / النظام</div><h1>الأدوار والصلاحيات</h1><p>الأدوار المعرفة حاليًا في نظام Identity.</p></div></div><section class="panel"><div class="table-wrap"><table><thead><tr><th>الدور</th><th>المعرف</th><th>الحالة</th></tr></thead><tbody>@foreach(var role in Model){<tr><td><b>@role.Name</b></td><td dir="ltr">@role.Id</td><td><span class="badge green">مفعّل</span></td></tr>}@if(!Model.Any()){<tr><td colspan="3" class="empty">لا توجد أدوار.</td></tr>}</tbody></table></div></section>
