@model IEnumerable<EddaStore.Models.Identity.ApplicationUser>
@{
    ViewData["Title"] = "العملاء"; ViewData["Heading"] = "العملاء";
}
<div class="page-head">
    <div>
        <div class="eyebrow">عِدّة / المبيعات</div>
        <h1>العملاء</h1>
        <p>قائمة حسابات العملاء المسجلة في المتجر.</p>
    </div>
</div>
<section class="panel">
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>البريد الإلكتروني</th>
                    <th>الهاتف</th>
                    <th>تاريخ الإنشاء</th>
                    <th>الإجراء</th>
                </tr>
            </thead>
            <tbody>@foreach(var user in Model){
                <tr>
                    <td><b>@user.Email</b></td>
                    <td>@(user.PhoneNumber ?? "—")</td>
                    <td>@user.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</td>
                    <td><a class="mini-link" asp-controller="Users" asp-action="Edit" asp-route-id="@user.Id">إدارة
                        الحساب</a></td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="empty">لا يوجد عملاء حتى الآن.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>