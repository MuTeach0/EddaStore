@model IEnumerable<EddaStore.Models.Products.Product>
@{ ViewData["Title"]="المخزون"; ViewData["Heading"]="المخزون"; }
<div class="page-head"><div><div class="eyebrow">عِدّة / إدارة المتجر</div><h1>المخزون</h1><p>راقب الكميات وحدد المنتجات التي تحتاج إلى إعادة توريد.</p></div><div class="actions"><a class="btn primary" asp-controller="Products" asp-action="Index">إدارة المنتجات</a></div></div><section class="panel"><div class="panel-head"><div><h2>قائمة المخزون</h2><p>بيانات حية من كتالوج المتجر.</p></div></div><div class="table-wrap"><table><thead><tr><th>المنتج</th><th>SKU</th><th>المتاح</th><th>الحالة</th><th>الإجراء</th></tr></thead><tbody>@foreach(var p in Model){<tr><td><b>@p.Name</b></td><td dir="ltr">@(p.SKU??"—")</td><td>@p.StockQuantity</td><td><span class="badge @(p.StockQuantity == 0 ? "red" : p.StockQuantity <= 5 ? "gold" : "green")">@(p.StockQuantity == 0 ? "نفد" : p.StockQuantity <= 5 ? "منخفض" : "متوفر")</span></td><td><a class="mini-link" asp-controller="Products" asp-action="Edit" asp-route-id="@p.Id">تعديل الكمية</a></td></tr>}@if(!Model.Any()){<tr><td colspan="5" class="empty">لا توجد منتجات.</td></tr>}</tbody></table></div></section>
