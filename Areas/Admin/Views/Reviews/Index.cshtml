@model IEnumerable<EddaStore.Models.Customers.Review>
@{ViewData["Title"]="إدارة المراجعات";ViewData["Heading"]="المراجعات";}
<div class="admin-page-header"><div><h2>مراجعات العملاء</h2><p>اعتماد أو إخفاء مراجعات المنتجات.</p></div></div><div class="admin-table-card"><table class="admin-table"><thead><tr><th>التقييم</th><th>التعليق</th><th>الحالة</th><th>الإجراءات</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Rating / 5</td><td>@(x.Comment??"—")</td><td><span class="admin-badge">@(x.IsApproved?"معتمدة":"بانتظار المراجعة")</span></td><td class="admin-actions"><form asp-action="SetApproval" method="post"><input type="hidden" name="id" value="@x.Id"/><input type="hidden" name="approved" value="@(!x.IsApproved)"/><button type="submit">@(x.IsApproved?"إلغاء الاعتماد":"اعتماد")</button></form><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@x.Id"/><button type="submit">حذف</button></form></td></tr>}@if(!Model.Any()){<tr><td colspan="4" class="admin-empty">لا توجد مراجعات.</td></tr>}</tbody></table></div>
