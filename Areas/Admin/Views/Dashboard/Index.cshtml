@model EddaStore.Models.ViewModels.Admin.Dashboard.DashboardViewModel
@{ ViewData["Title"]="لوحة التحكم"; ViewData["Heading"]="لوحة التحكم"; var cancellationRate=Model.TotalOrders == 0 ? 0 : Model.CancelledOrders * 100m / Model.TotalOrders; }
<div class="page-head"><div><div class="eyebrow">عِدّة / لوحة الإدارة</div><h1>التقارير والتحليلات</h1><p>تابع مؤشرات الأداء واتجاهات المبيعات من بيانات المتجر.</p></div><div class="actions"><a class="btn primary" asp-controller="Products" asp-action="Create">＋ إضافة منتج</a><a class="btn" asp-controller="Tools" asp-action="Reports">عرض التقرير الكامل</a></div></div>
<div class="grid stats"><div class="stat"><div class="stat-top"><span>إجمالي المبيعات</span><span class="stat-icon">▥</span></div><strong>@Model.TotalRevenue.ToString("N0") ج.م</strong><div class="trend">المدفوعات الناجحة</div></div><div class="stat"><div class="stat-top"><span>الطلبات</span><span class="stat-icon">▧</span></div><strong>@Model.TotalOrders</strong><div class="trend">الطلبات المسجلة</div></div><div class="stat"><div class="stat-top"><span>المنتجات النشطة</span><span class="stat-icon">▣</span></div><strong>@Model.ActiveProducts</strong><div class="trend">@Model.LowStockProducts منتج بمخزون منخفض</div></div><div class="stat"><div class="stat-top"><span>معدل الإلغاء</span><span class="stat-icon">↺</span></div><strong>@cancellationRate.ToString("N1")%</strong><div class="trend">@Model.CancelledOrders طلب ملغي</div></div></div>
<div class="grid two-col"><section class="panel"><div class="panel-head"><div><h2>حالة العمليات</h2><p>توزيع حالات الطلبات الحالية.</p></div></div><div class="bar-list"><div><div class="bar-label"><span>تم التسليم</span><b>@Model.DeliveredOrders</b></div><div class="bar"><span style="width:@(Model.TotalOrders == 0 ? 0 : Model.DeliveredOrders * 100 / Model.TotalOrders)%"></span></div></div><div><div class="bar-label"><span>قيد التجهيز</span><b>@Model.ProcessingOrders</b></div><div class="bar"><span style="width:@(Model.TotalOrders == 0 ? 0 : Model.ProcessingOrders * 100 / Model.TotalOrders)%"></span></div></div><div><div class="bar-label"><span>قيد الانتظار</span><b>@Model.PendingOrders</b></div><div class="bar"><span style="width:@(Model.TotalOrders == 0 ? 0 : Model.PendingOrders * 100 / Model.TotalOrders)%"></span></div></div></div></section><section class="panel"><div class="panel-head"><div><h2>إجراءات سريعة</h2></div></div><div class="grid"><a class="btn primary" asp-controller="Products" asp-action="Create">＋ إضافة منتج جديد</a><a class="btn" asp-controller="Orders" asp-action="Index">▧ مراجعة الطلبات</a><a class="btn" asp-controller="Tools" asp-action="Inventory">▤ متابعة المخزون</a><a class="btn" asp-controller="Tools" asp-action="Reports">▥ عرض التقارير</a></div></section></div>
<section class="panel"><div class="panel-head"><div><h2>أحدث الطلبات</h2><p>آخر 5 طلبات مسجلة في المتجر.</p></div></div><div class="table-wrap"><table><thead><tr><th>رقم الطلب</th><th>الحالة</th><th>الإجمالي</th><th>التاريخ</th><th></th></tr></thead><tbody>@foreach(var order in Model.RecentOrders){<tr><td><b>@order.OrderNumber</b></td><td><span class="badge gold">@order.Status</span></td><td>@order.TotalAmount.ToString("N2") @order.Currency</td><td>@(order.PlacedAt?.ToLocalTime().ToString("yyyy/MM/dd")??"—")</td><td><a class="mini-link" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">التفاصيل ←</a></td></tr>}@if(!Model.RecentOrders.Any()){<tr><td colspan="5" class="empty">لا توجد طلبات لعرضها حتى الآن.</td></tr>}</tbody></table></div></section>
