@model EddaStore.Models.ViewModels.Admin.Users.UserEditViewModel
@{ var editing=Model.Id != Guid.Empty; ViewData["Title"]=editing?"تعديل مستخدم":"إضافة مستخدم"; ViewData["Heading"]=ViewData["Title"]; }
<div class="admin-page-header"><div><h2>@ViewData["Title"]</h2><p>أدخل بيانات الحساب ومستوى الصلاحيات.</p></div><a asp-action="Index" class="admin-secondary-btn">العودة للقائمة</a></div>
<form method="post" class="admin-form-card"><div asp-validation-summary="ModelOnly" class="admin-validation"></div><input asp-for="Id" type="hidden"/><div class="admin-form-grid"><div><label asp-for="Email"></label><input asp-for="Email" dir="ltr"/><span asp-validation-for="Email"></span></div><div><label asp-for="PhoneNumber"></label><input asp-for="PhoneNumber" dir="ltr"/><span asp-validation-for="PhoneNumber"></span></div>@if (ViewBag.Addresses is List<EddaStore.Models.Customers.Address> savedAddresses && savedAddresses.Any())
{
    <div style="grid-column:1/-1">
        <h3>العناوين المحفوظة</h3>
        @foreach (var a in savedAddresses)
        {
            <div><strong>@a.FullName</strong> — @a.City، @a.StreetAddress <small>(@a.PhoneNumber)</small></div>
        }
    </div>
}
@if(!editing){<div><label>كلمة المرور</label><input name="password" type="password" dir="ltr" required minlength="8"/><span class="field-validation-error">@Html.ValidationMessage("password")</span></div>}<label class="admin-check"><input asp-for="IsAdmin"/> منح صلاحية مدير النظام</label></div><div class="admin-form-actions"><a asp-action="Index" class="admin-secondary-btn">إلغاء</a><button class="dashboard-primary-btn">@(editing?"حفظ التعديلات":"إنشاء المستخدم")</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
