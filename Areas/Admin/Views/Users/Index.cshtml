@model IEnumerable<EddaStore.Models.Identity.ApplicationUser>
@{ ViewData["Title"]="إدارة المستخدمين"; ViewData["Heading"]="المستخدمون"; }
<div class="admin-page-header"><div><h2>المستخدمون</h2><p>أدر حسابات الوصول إلى المتجر ولوحة الإدارة.</p></div><a asp-action="Create" class="dashboard-primary-btn">+ إضافة مستخدم</a></div>
<div class="admin-table-card"><table class="admin-table"><thead><tr><th>البريد الإلكتروني</th><th>الهاتف</th><th>تاريخ الإنشاء</th><th>الإجراءات</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.Email</strong></td><td>@(x.PhoneNumber ?? "—")</td><td>@x.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd")</td><td class="admin-actions"><a asp-action="Edit" asp-route-id="@x.Id">تعديل</a><form asp-action="Delete" asp-route-id="@x.Id" method="post" onsubmit="return confirm('هل تريد حذف هذا المستخدم؟');"><button>حذف</button></form></td></tr>}@if(!Model.Any()){<tr><td colspan="4" class="admin-empty">لا يوجد مستخدمون.</td></tr>}</tbody></table></div>
