@model IEnumerable<EddaStore.Models.Coupons.Coupon>
@{ViewData["Title"]="إدارة الكوبونات";ViewData["Heading"]="الكوبونات";}
<div class="admin-page-header"><div><h2>كوبونات الخصم</h2><p>إدارة أكواد الخصم والعروض.</p></div><a asp-action="Create" class="dashboard-primary-btn">+ إضافة كوبون</a></div><div class="admin-table-card"><table class="admin-table"><thead><tr><th>الكود</th><th>الخصم</th><th>الفترة</th><th>الاستخدام</th><th>الحالة</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.Code</strong><small>@x.Description</small></td><td>@x.DiscountValue @(x.DiscountType=="Percentage"?"%":"ج.م")</td><td>@x.StartsAt.ToLocalTime().ToString("yyyy/MM/dd") - @x.ExpiresAt.ToLocalTime().ToString("yyyy/MM/dd")</td><td>@x.UsageCount / @(x.UsageLimit?.ToString()??"∞")</td><td><span class="admin-badge">@(x.IsActive?"نشط":"موقوف")</span></td><td class="admin-actions"><a asp-action="Edit" asp-route-id="@x.Id">تعديل</a><form asp-action="Delete" asp-route-id="@x.Id" method="post"><button>حذف</button></form></td></tr>}@if(!Model.Any()){<tr><td colspan="6" class="admin-empty">لا توجد كوبونات.</td></tr>}</tbody></table></div>
