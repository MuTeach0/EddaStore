@model EddaStore.Models.ViewModels.Admin.Coupons.CouponEditViewModel
@{var edit=Model.Id!=Guid.Empty;ViewData["Title"]=edit?"تعديل كوبون":"إضافة كوبون";ViewData["Heading"]=ViewData["Title"];}
<div class="admin-page-header"><div><h2>@ViewData["Title"]</h2></div><a asp-action="Index" class="admin-secondary-btn">العودة</a></div><form method="post" class="admin-form-card"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="admin-validation"></div><div class="admin-form-grid"><div><label asp-for="Code"></label><input asp-for="Code" dir="ltr"/><span asp-validation-for="Code"></span></div><div><label asp-for="DiscountType"></label><select asp-for="DiscountType"><option value="Percentage">نسبة مئوية</option><option value="FixedAmount">قيمة ثابتة</option></select></div><div><label asp-for="DiscountValue"></label><input asp-for="DiscountValue" type="number" step="0.01"/></div><div><label asp-for="UsageLimit"></label><input asp-for="UsageLimit" type="number" min="0"/></div><div><label asp-for="StartsAt"></label><input asp-for="StartsAt" type="datetime-local"/></div><div><label asp-for="ExpiresAt"></label><input asp-for="ExpiresAt" type="datetime-local"/></div><div class="admin-form-wide"><label asp-for="Description"></label><textarea asp-for="Description"></textarea></div><label class="admin-check"><input asp-for="IsActive"/> الكوبون نشط</label></div><div class="admin-form-actions"><button class="dashboard-primary-btn">حفظ</button></div></form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
