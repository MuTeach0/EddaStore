@model IEnumerable<EddaStore.Models.Products.Category>
@{ ViewData["Title"]="إدارة التصنيفات"; ViewData["Heading"]="التصنيفات"; }
<div class="admin-page-header"><div><h2>إدارة التصنيفات</h2><p>نظّم أقسام منتجات المتجر.</p></div><a asp-action="Create" class="dashboard-primary-btn">+ إضافة تصنيف</a></div>
<div class="admin-table-card"><table class="admin-table"><thead><tr><th>الاسم</th><th>الرابط</th><th>التصنيف الأب</th><th>الإجراءات</th></tr></thead><tbody>@foreach(var x in Model){<tr><td><strong>@x.Name</strong><small>@x.Description</small></td><td dir="ltr">@x.Slug</td><td>@(x.ParentCategory?.Name ?? "—")</td><td class="admin-actions"><a asp-action="Edit" asp-route-id="@x.Id">تعديل</a><form asp-action="Delete" asp-route-id="@x.Id" method="post" onsubmit="return confirm('هل تريد حذف هذا التصنيف؟');"><button>حذف</button></form></td></tr>}@if(!Model.Any()){<tr><td colspan="4" class="admin-empty">لا توجد تصنيفات بعد.</td></tr>}</tbody></table></div>
