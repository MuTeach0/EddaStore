@model EddaStore.Models.ViewModels.Admin.Products.ProductIndexViewModel
@using Microsoft.AspNetCore.Mvc.Rendering
@{ ViewData["Title"]="المنتجات"; ViewData["Heading"]="المنتجات"; var categories=ViewBag.Categories as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>(); var brands=ViewBag.Brands as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>(); var totalPages=(int)Math.Ceiling(Model.TotalCount/(double)Model.PageSize); }
<div class="page-head"><div><div class="eyebrow">عِدّة / إدارة المتجر</div><h1>المنتجات</h1><p>إدارة الكتالوج والأسعار والمخزون.</p></div><div class="actions"><a class="btn primary" asp-action="Create">＋ إضافة منتج</a></div></div>
<div class="grid stats"><div class="stat"><div class="stat-top"><span>إجمالي المنتجات</span><span class="stat-icon">▣</span></div><strong>@Model.TotalCount</strong><div class="trend">نتائج وفق الفلاتر الحالية</div></div><div class="stat"><div class="stat-top"><span>صفحة النتائج</span><span class="stat-icon">▤</span></div><strong>@Model.Page / @(Math.Max(1,totalPages))</strong><div class="trend">@Model.PageSize منتجًا في الصفحة</div></div></div>
<section class="panel"><div class="panel-head"><div><h2>قائمة المنتجات</h2><p>ابحث وصفِّ النتائج ثم نفّذ الإجراء المناسب.</p></div></div><form method="get" asp-action="Index" class="filters"><input asp-for="SearchTerm" placeholder="ابحث بالاسم أو SKU..." aria-label="البحث عن منتج"/><select asp-for="CategoryId" asp-items="categories"><option value="">كل الأقسام</option></select><select asp-for="BrandId" asp-items="brands"><option value="">كل العلامات</option></select><select asp-for="IsActive"><option value="">كل الحالات</option><option value="true">نشط</option><option value="false">غير نشط</option></select><input type="hidden" name="Page" value="1"/><button class="btn primary" type="submit">بحث وتصفية</button><a class="btn" asp-action="Index">إعادة ضبط</a></form><div class="table-wrap"><table><thead><tr><th>المنتج</th><th>القسم</th><th>العلامة</th><th>السعر</th><th>المخزون</th><th>الحالة</th><th>الإجراءات</th></tr></thead><tbody>@if(!Model.Products.Any()){<tr><td colspan="7" class="empty">لا توجد منتجات تطابق معايير البحث.</td></tr>}else{@foreach(var product in Model.Products){<tr><td><span class="product"><span class="thumb">▣</span><span><b>@product.Name</b><small dir="ltr">SKU: @(product.SKU??"—")</small></span></span></td><td>@product.Category.Name</td><td>@product.Brand.Name</td><td><b>@product.Price.ToString("N2") ج.م</b>@if(product.CompareAtPrice.HasValue){<small style="display:block;color:#737B74;text-decoration:line-through">@product.CompareAtPrice.Value.ToString("N2") ج.م</small>}</td><td><span class="badge @(product.StockQuantity == 0 ? "red" : product.StockQuantity <= 5 ? "gold" : "green")">@product.StockQuantity</span></td><td><span class="badge @(product.IsActive ? "green" : "gold")">@(product.IsActive ? "نشط" : "غير نشط")</span></td><td><div class="admin-actions"><a class="mini-link" asp-action="Edit" asp-route-id="@product.Id">تعديل</a><form asp-action="Delete" asp-route-id="@product.Id" method="post" onsubmit="return confirm('هل أنت متأكد من حذف هذا المنتج؟');"><button type="submit">حذف</button></form></div></td></tr>}}</tbody></table></div>@if(totalPages>1){<div class="pagination"><span>صفحة @Model.Page من @totalPages · @Model.TotalCount نتيجة</span><div class="pills">@if(Model.Page>1){<a class="pill" asp-route-Page="@(Model.Page-1)" asp-route-PageSize="@Model.PageSize" asp-route-SearchTerm="@Model.SearchTerm" asp-route-CategoryId="@Model.CategoryId" asp-route-BrandId="@Model.BrandId" asp-route-IsActive="@Model.IsActive">السابق</a>}<span class="pill active">@Model.Page</span>@if(Model.Page<totalPages){<a class="pill" asp-route-Page="@(Model.Page+1)" asp-route-PageSize="@Model.PageSize" asp-route-SearchTerm="@Model.SearchTerm" asp-route-CategoryId="@Model.CategoryId" asp-route-BrandId="@Model.BrandId" asp-route-IsActive="@Model.IsActive">التالي ←</a>}</div></div>}</section>
