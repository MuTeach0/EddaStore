@model EddaStore.Models.ViewModels.Admin.Catalog.CatalogItemViewModel
@{
    var editing = Model.Id != Guid.Empty; ViewData["Title"] = editing ? "تعديل ماركة" : "إضافة ماركة";
    ViewData["Heading"] = ViewData["Title"];
}
<div class="admin-page-header">
    <div>
        <h2>@ViewData["Title"]</h2>
        <p>أدخل بيانات العلامة التجارية واحفظ التغييرات.</p>
    </div><a asp-action="Index" class="admin-secondary-btn">العودة للقائمة</a>
</div>
<form method="post" class="admin-form-card">
    <div asp-validation-summary="ModelOnly" class="admin-validation"></div><input asp-for="Id" type="hidden" />
    <div class="admin-form-grid">
        <div><label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name"></span></div>
        <div><label asp-for="Slug"></label><input asp-for="Slug" dir="ltr" /><span asp-validation-for="Slug"></span>
        </div>
        <div class="admin-form-wide"><label asp-for="Description"></label><textarea asp-for="Description"
                                                                                        rows="4"></textarea><span asp-validation-for="Description"></span></div>
            <div class="admin-form-wide"><label asp-for="LogoUrl"></label><input asp-for="LogoUrl" dir="ltr" /><span
                asp-validation-for="LogoUrl"></span></div>
            </div>
            <div class="admin-form-actions"><a asp-action="Index" class="admin-secondary-btn">إلغاء</a><button
                class="dashboard-primary-btn">@(editing?"حفظ التعديلات":"إضافة الماركة")</button></div>
            </form>
            @section Scripts {
                <partial name="_ValidationScriptsPartial" />
            }